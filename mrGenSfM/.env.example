# ============================================================================
# mrGenSfM Environment Configuration (.env.example)
# Copy this file to .env and fill in the API keys for the providers you use.
# Never commit real API keys into version control or .mg project files.
# ============================================================================

# --- Multimodal LLM Providers (for engineType="llm_guided_sfm" & smart view selection) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- 3D Cloud AI & Serverless GPU Providers (for engineType="gensfm_diffusion", executionBackend="cloud_api") ---
GENSFM_API_KEY=
GENSFM_CLOUD_URL=http://127.0.0.1:8000
GENSFM_DEFAULT_ENDPOINT=http://127.0.0.1:8000
HF_TOKEN=
FAL_KEY=
REPLICATE_API_TOKEN=

# --- Local GPU / WSL2 / Docker Runtime Configuration ---
GENSFM_WSL_DISTRO=Ubuntu
GENSFM_WSL_CONDA_ENV=gensfm
GENSFM_REPO_PATH=D:\Meshroom\GenSfm
GENSFM_DOCKER_IMAGE=gensfm:cu128
ATTN_BACKEND=sdpa
ATTN_BACKEND_WITH_ATTN_BIAS=sdpa
SPCONV_ALGO=native
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
